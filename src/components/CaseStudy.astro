---
import Header from './Header.astro';
import { copy } from '../i18n/content';
import type { Locale } from '../i18n';
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy(locale);
const homeHref = getRelativeLocaleUrl(locale, '/');
---

<Header locale={locale} />
<main class="mx-auto max-w-3xl px-5 py-16">
  <p class="font-mono text-xs uppercase tracking-[0.18em] text-accent">{t.caseStudy.kicker}</p>
  <h1 class="mt-3 text-3xl font-medium tracking-tight text-ink">{t.caseStudy.title}</h1>
  <p class="mt-3 font-mono text-xs text-mute">{t.caseStudy.stack}</p>
  <p class="mt-8 text-[17px] leading-7 text-ink/90">{t.caseStudy.intro}</p>

  <h2 class="mt-12 font-mono text-xs uppercase tracking-[0.18em] text-mute">{t.caseStudy.reposLabel}</h2>
  <ul class="mt-4 space-y-2 text-sm">
    <li>
      <a class="text-accent hover:text-ink" href={t.links.appRepo}>{t.links.appRepo.replace('https://', '')}</a>
    </li>
    <li>
      <a class="text-accent hover:text-ink" href={t.links.gitopsRepo}>{t.links.gitopsRepo.replace('https://', '')}</a>
    </li>
  </ul>

  <div class="mt-12 space-y-10">
    {
      t.caseStudy.sections.map((section) => (
        <section>
          <h2 class="text-lg font-medium text-ink">{section.title}</h2>
          <p class="mt-3 text-[15px] leading-7 text-ink/85">{section.body}</p>
        </section>
      ))
    }
  </div>

  <p class="mt-16">
    <a class="text-sm text-accent hover:text-ink" href={homeHref}>{t.caseStudy.back}</a>
  </p>
</main>
