---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { copy } from '../i18n/content';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy(locale);
const other: Locale = locale === 'fr' ? 'en' : 'fr';
const rest = Astro.url.pathname.replace(/^\/(fr|en)/, '') || '/';
const otherHref = getRelativeLocaleUrl(other, rest);
const homeHref = getRelativeLocaleUrl(locale, '/');
---

<header class="border-b border-line">
  <div class="mx-auto flex max-w-3xl items-baseline justify-between gap-4 px-5 py-5">
    <a href={homeHref} class="text-sm font-medium tracking-tight text-ink">
      TOUNLI Aboubaker
    </a>
    <nav class="flex flex-wrap items-center justify-end gap-x-4 gap-y-1 text-sm text-mute">
      <a class="hover:text-ink" href={`${homeHref}#about`}>{t.nav.about}</a>
      <a class="hover:text-ink" href={`${homeHref}#experience`}>{t.nav.experience}</a>
      <a class="hover:text-ink" href={`${homeHref}#projects`}>{t.nav.projects}</a>
      <a class="hover:text-ink" href={`${homeHref}#skills`}>{t.nav.skills}</a>
      <a class="hover:text-ink" href={`${homeHref}#contact`}>{t.nav.contact}</a>
      <a
        class="font-mono text-xs uppercase tracking-wider text-accent hover:text-ink"
        href={otherHref}
        data-locale-switch={other}
      >
        {other}
      </a>
    </nav>
  </div>
</header>

<script is:inline>
  document.querySelectorAll('[data-locale-switch]').forEach((el) => {
    el.addEventListener('click', () => {
      const next = el.getAttribute('data-locale-switch');
      if (next) localStorage.setItem('locale', next);
    });
  });
</script>
