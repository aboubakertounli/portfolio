---
import Header from './Header.astro';
import { copy } from '../i18n/content';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy(locale);
const cvHref = `${import.meta.env.BASE_URL}${locale === 'fr' ? t.links.cvFr : t.links.cvEn}`;
---

<Header locale={locale} />
<main class="mx-auto max-w-6xl px-5">
  <section id="about" class="grid scroll-mt-24 gap-10 py-16 md:grid-cols-[1.4fr_1fr] md:items-end md:py-24">
    <div>
      <p class="inline-flex items-center gap-2 rounded-full border border-accent/30 bg-accent-dim px-3 py-1 text-xs font-medium text-accent">
        <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
        {t.home.available}
      </p>
      <h1 class="mt-5 text-4xl font-semibold tracking-tight text-ink sm:text-6xl">
        TOUNLI<br />Aboubaker
      </h1>
      <p class="mt-4 text-lg text-mute">{t.home.role}</p>
      <p class="mt-2 text-sm text-mute">{t.home.location}</p>
      <p class="mt-6 max-w-xl text-base leading-7 text-ink/90">{t.home.about}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          class="rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-bg transition hover:brightness-110"
          href={cvHref}
        >
          {t.home.cv}
        </a>
        <a
          class="rounded-full border border-line px-5 py-2.5 text-sm font-medium text-ink transition hover:border-accent hover:text-accent"
          href={t.links.github}
        >
          {t.home.github}
        </a>
        <a
          class="rounded-full border border-line px-5 py-2.5 text-sm font-medium text-ink transition hover:border-accent hover:text-accent"
          href={t.links.linkedin}
        >
          {t.home.linkedin}
        </a>
      </div>
    </div>
    <dl class="grid gap-3">
      {
        t.home.highlights.map((item) => (
          <div class="rounded-2xl border border-line bg-surface px-5 py-4">
            <dt class="font-mono text-2xl font-medium text-accent">{item.value}</dt>
            <dd class="mt-1 text-sm text-mute">{item.label}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section id="experience" class="scroll-mt-24 border-t border-line py-16">
    <h2 class="text-sm font-medium uppercase tracking-[0.16em] text-mute">{t.nav.experience}</h2>
    <div class="mt-8 grid gap-5 md:grid-cols-2">
      {
        t.experience.map((job) => (
          <article class="rounded-2xl border border-line bg-surface p-6">
            <p class="font-mono text-xs text-accent">{job.dates}</p>
            <h3 class="mt-2 text-xl font-semibold text-ink">{job.title}</h3>
            <p class="mt-1 text-sm text-mute">
              {job.org} · {job.place}
            </p>
            <ul class="mt-5 space-y-3 text-sm leading-6 text-ink/85">
              {job.points.map((point) => (
                <li class="pl-4 relative before:absolute before:left-0 before:top-2.5 before:h-1 before:w-1 before:rounded-full before:bg-accent">
                  {point}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <section id="projects" class="scroll-mt-24 border-t border-line py-16">
    <h2 class="text-sm font-medium uppercase tracking-[0.16em] text-mute">{t.nav.projects}</h2>
    <div class="mt-8 grid gap-5 md:grid-cols-3">
      {
        t.projects.map((project) => (
          <article class="flex flex-col rounded-2xl border border-line bg-surface p-6">
            <h3 class="text-lg font-semibold text-ink">{project.title}</h3>
            <ul class="mt-4 flex-1 space-y-2 text-sm leading-6 text-mute">
              {project.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
            <div class="mt-5 flex flex-wrap gap-1.5">
              {project.tags.map((tag) => (
                <span class="rounded-full border border-line px-2.5 py-0.5 font-mono text-[11px] text-mute">
                  {tag}
                </span>
              ))}
            </div>
            {project.repos.length > 0 && (
              <div class="mt-5 flex flex-wrap gap-3 border-t border-line pt-4">
                {project.repos.map((repo) => (
                  <a
                    class="text-sm font-medium text-accent transition hover:text-ink"
                    href={repo.href}
                    rel="noreferrer"
                    target="_blank"
                  >
                    {repo.label} ↗
                  </a>
                ))}
              </div>
            )}
          </article>
        ))
      }
    </div>
  </section>

  <section id="skills" class="scroll-mt-24 border-t border-line py-16">
    <h2 class="text-sm font-medium uppercase tracking-[0.16em] text-mute">{t.nav.skills}</h2>
    <div class="mt-8 grid gap-8 md:grid-cols-2">
      {
        t.skills.map((group) => (
          <div>
            <h3 class="text-sm font-medium text-ink">{group.label}</h3>
            <div class="mt-3 flex flex-wrap gap-2">
              {group.items.split(',').map((item) => (
                <span class="rounded-full bg-surface px-3 py-1 text-sm text-mute ring-1 ring-line">
                  {item.trim()}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
    <p class="mt-10 text-sm text-mute">{t.languages}</p>
    <div class="mt-8 grid gap-4 md:grid-cols-2">
      {
        t.education.map((item) => (
          <div class="rounded-2xl border border-line bg-surface px-5 py-4">
            <p class="font-medium text-ink">{item.school}</p>
            <p class="mt-1 text-sm text-mute">{item.detail}</p>
            <p class="mt-2 font-mono text-xs text-accent">
              {item.dates} · {item.place}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <section id="contact" class="scroll-mt-24 border-t border-line py-16">
    <h2 class="text-sm font-medium uppercase tracking-[0.16em] text-mute">{t.nav.contact}</h2>
    <p class="mt-4 max-w-xl text-lg text-ink">{t.contact.lead}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a class="rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-bg" href={t.links.email}>
        {t.links.emailLabel}
      </a>
      <a class="rounded-full border border-line px-5 py-2.5 text-sm text-ink" href={t.links.phone}>
        {t.links.phoneLabel}
      </a>
      <a class="rounded-full border border-line px-5 py-2.5 text-sm text-ink" href={t.links.linkedin}>
        LinkedIn
      </a>
      <a class="rounded-full border border-line px-5 py-2.5 text-sm text-ink" href={t.links.github}>
        GitHub
      </a>
    </div>
  </section>
</main>
